<%- include('partials/header', { title: '维护记录' }) %>
<section class="panel stack">
  <h1>维护记录</h1>
  <table class="responsive-table">
    <thead><tr><th>ID</th><th>机台</th><th>编号</th><th>类型</th><th>处理人</th><th>关联报修</th><th>时间</th><th></th></tr></thead>
    <tbody>
      <% maintenanceLogs.forEach((log) => { %>
        <tr>
          <td data-label="ID"><%= log.id %></td>
          <td data-label="机台"><%= log.machine_name %></td>
          <td data-label="编号"><%= log.machine_code %></td>
          <td data-label="类型"><%= log.type_name %></td>
          <td data-label="处理人"><%= log.operator_name %></td>
          <td data-label="关联报修">#<%= log.repair_record_id %></td>
          <td data-label="时间"><%= formatDateTime(log.created_at) %></td>
          <td data-label="操作">
            <div class="inline-actions">
              <a href="/admin/maintenance-logs/<%= log.id %>">详情</a>
              <form method="post" action="/admin/maintenance-logs/<%= log.id %>/delete" data-confirm="确认删除该维护记录吗？删除后不可恢复。" data-confirm-confirm-text="确认删除" data-confirm-cancel-text="返回">
                <button class="link-button danger-text" type="submit">删除</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('partials/footer') %>
