<%- include('partials/header', { title: machine.name }) %>
<section class="grid two-columns">
  <article class="panel stack">
    <h1><%= machine.name %></h1>
    <dl class="details-grid">
      <div><dt>机台类型</dt><dd><%= machineType.name %></dd></div>
      <div><dt>机台编号</dt><dd><%= machine.machine_code %></dd></div>
      <div><dt>位置</dt><dd><%= machine.location %></dd></div>
      <div><dt>当前状态</dt><dd><%= machine.status %></dd></div>
      <% if (machine.description) { %>
        <div class="full"><dt>描述</dt><dd><%= machine.description %></dd></div>
      <% } %>
    </dl>
  </article>

  <article class="panel stack">
    <h2>我要报修</h2>
    <% if (typeof submitted !== 'undefined') { %><p class="success">报修已提交。</p><% } %>
    <form method="post" action="/machine/<%= machine.qr_token %>/repairs" class="stack">
      <label>
        问题描述
        <textarea name="content" rows="5" required placeholder="例如：左侧屏幕触摸失灵"></textarea>
      </label>
      <button class="button" type="submit">提交报修</button>
    </form>
  </article>
</section>

<section class="grid two-columns top-gap">
  <article class="panel stack">
    <h2>最近报修记录</h2>
    <% if (recentRepairs.length === 0) { %>
      <p>暂无报修记录。</p>
    <% } else { %>
      <div class="stack">
        <% recentRepairs.forEach((repair) => { %>
          <article class="card stack compact">
            <strong><%= repair.status %></strong>
            <span><%= repair.created_at %></span>
            <p><%= repair.content %></p>
          </article>
        <% }) %>
      </div>
    <% } %>
  </article>

  <article class="panel stack">
    <h2>最近维修日志</h2>
    <% if (recentMaintenanceLogs.length === 0) { %>
      <p>暂无维修日志。</p>
    <% } else { %>
      <div class="stack">
        <% recentMaintenanceLogs.forEach((log) => { %>
          <article class="card stack compact">
            <strong><%= log.operator_name %></strong>
            <span><%= log.created_at %></span>
            <p><%= log.content %></p>
            <span>结果：<%= log.result %></span>
          </article>
        <% }) %>
      </div>
    <% } %>
  </article>
</section>
<%- include('partials/footer') %>
