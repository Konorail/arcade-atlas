<%- include('partials/header', { title: machine.name }) %>
<section class="grid two-columns">
  <article class="panel stack">
    <h1><%= machine.name %></h1>
    <dl class="details-grid">
      <div><dt>机台类型</dt><dd><%= machineType.name %></dd></div>
      <div><dt>机台编号</dt><dd><%= machine.machine_code %></dd></div>
      <div><dt>位置</dt><dd><%= machine.location %></dd></div>
      <div>
        <dt>当前状态</dt>
        <dd><span class="status-badge <%= machineStatusClass(machine.status) %>"><%= machineStatusLabel(machine.status) %></span></dd>
      </div>
      <% if (machine.description) { %>
        <div class="full"><dt>描述</dt><dd><%= machine.description %></dd></div>
      <% } %>
    </dl>
  </article>

  <article class="panel stack">
    <h2>我要报修</h2>
    <form id="repair-form" class="stack" novalidate>
      <label>
        问题描述
        <textarea id="repair-content" name="content" rows="5" required placeholder="例如：左侧屏幕触摸失灵" minlength="5"></textarea>
      </label>
      <button class="button" type="submit" id="repair-submit">提交报修</button>
    </form>
  </article>
</section>

<section class="grid two-columns top-gap">
  <article class="panel stack">
    <h2>最近报修记录</h2>
    <div id="repairs-feed">
      <% if (recentRepairs.length === 0) { %>
        <p class="empty-state">暂无报修记录。</p>
      <% } else { %>
        <% recentRepairs.forEach((repair) => { %>
          <div class="feed-item">
            <div class="feed-dot"></div>
            <div>
              <div style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.15rem;">
                <span class="status-badge <%= repairStatusClass(repair.status) %>"><%= repairStatusLabel(repair.status) %></span>
              </div>
              <div class="feed-time"><%= repair.created_at.replace('T',' ').slice(0,16) %></div>
              <div class="feed-content"><%= repair.content %></div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </article>

  <article class="panel stack">
    <h2>最近维修日志</h2>
    <% if (recentMaintenanceLogs.length === 0) { %>
      <p class="empty-state">暂无维修日志。</p>
    <% } else { %>
      <% recentMaintenanceLogs.forEach((log) => { %>
        <div class="feed-item">
          <div class="feed-dot" style="background:#7c3aed;"></div>
          <div>
            <div class="feed-machine" style="font-size:0.9rem;font-weight:700;"><%= log.operator_name %></div>
            <div class="feed-time"><%= log.created_at.replace('T',' ').slice(0,16) %></div>
            <div class="feed-content"><%= log.content %></div>
            <div class="feed-content" style="margin-top:0.2rem;">结果：<%= log.result %></div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </article>
</section>

<div class="toast-container" id="toast-container"></div>

<script>
(function() {
  var TOKEN = '<%= machine.qr_token %>';

  function showToast(message, type) {
    var container = document.getElementById('toast-container');
    var toast = document.createElement('div');
    toast.className = 'toast toast-' + (type || 'info');
    toast.textContent = message;
    container.appendChild(toast);
    requestAnimationFrame(function() { toast.classList.add('show'); });
    setTimeout(function() {
      toast.classList.remove('show');
      setTimeout(function() { toast.remove(); }, 300);
    }, 3500);
  }

  var form = document.getElementById('repair-form');
  var submitBtn = document.getElementById('repair-submit');
  var contentField = document.getElementById('repair-content');

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var content = contentField.value.trim();
    if (!content || content.length < 5) {
      showToast('请填写至少 5 个字的问题描述。', 'error');
      contentField.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = '提交中…';

    fetch('/api/machines/' + TOKEN + '/repairs', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content: content })
    })
    .then(function(res) {
      return res.json().then(function(data) { return { ok: res.ok, data: data }; });
    })
    .then(function(result) {
      if (result.ok) {
        form.reset();
        showToast('报修已提交。', 'success');
      } else {
        showToast(result.data.error || '提交失败，请重试。', 'error');
      }
    })
    .catch(function() {
      showToast('网络错误，请稍后重试。', 'error');
    })
    .finally(function() {
      submitBtn.disabled = false;
      submitBtn.textContent = '提交报修';
    });
  });
})();
</script>

<%- include('partials/footer') %>
