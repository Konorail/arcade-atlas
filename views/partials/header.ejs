<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#171815" />
    <title><%= title ? `${title} · ${appName}` : appName %></title>
    <script>
      (function () {
        try {
          var savedTheme = localStorage.getItem('arcade-atlas-theme');
          var systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          var theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : systemTheme;
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        } catch (_error) {
          document.documentElement.dataset.theme = 'light';
          document.documentElement.style.colorScheme = 'light';
        }
      })();
    </script>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="<%= currentPath.startsWith('/admin') ? 'admin-page' : 'public-page' %> <%= currentPath === '/' ? 'home-page' : '' %>">
    <div class="ambient" aria-hidden="true">
      <span class="ambient-orb ambient-orb-one"></span>
      <span class="ambient-orb ambient-orb-two"></span>
      <span class="ambient-orb ambient-orb-three"></span>
      <span class="ambient-orb ambient-orb-four"></span>
      <span class="ambient-orb ambient-orb-five"></span>
    </div>
    <div class="grain" aria-hidden="true"></div>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand" aria-label="<%= appName %> 首页">
          <span class="brand-mark" aria-hidden="true"><span></span></span>
          <span class="brand-copy">
            <strong><%= appName %></strong>
            <small>机台报修与维修管理系统</small>
          </span>
        </a>

        <nav id="site-nav" class="site-nav" data-site-nav aria-label="主导航">
          <a href="/" class="nav-link <%= currentPath === '/' ? 'is-active' : '' %>" <%= currentPath === '/' ? 'aria-current="page"' : '' %>>首页</a>
          <a href="/repairs" class="nav-link <%= currentPath === '/repairs' || currentPath.startsWith('/machine/') ? 'is-active' : '' %>" <%= currentPath === '/repairs' || currentPath.startsWith('/machine/') ? 'aria-current="page"' : '' %>>申请报修</a>
          <% if (currentUser) { %>
            <% if (currentUser.role === 'admin' || currentUser.role === 'repair') { %>
              <a href="/admin" class="nav-link <%= currentPath === '/admin' ? 'is-active' : '' %>" <%= currentPath === '/admin' ? 'aria-current="page"' : '' %>>后台</a>
            <% } %>
            <% if (currentUser.role === 'admin') { %>
              <a href="/admin/machine-types" class="nav-link <%= currentPath.startsWith('/admin/machine-types') ? 'is-active' : '' %>" <%= currentPath.startsWith('/admin/machine-types') ? 'aria-current="page"' : '' %>>机台类型</a>
              <a href="/admin/machines" class="nav-link <%= currentPath.startsWith('/admin/machines') ? 'is-active' : '' %>" <%= currentPath.startsWith('/admin/machines') ? 'aria-current="page"' : '' %>>具体机台</a>
              <a href="/admin/auth-settings" class="nav-link <%= currentPath.startsWith('/admin/auth-settings') ? 'is-active' : '' %>" <%= currentPath.startsWith('/admin/auth-settings') ? 'aria-current="page"' : '' %>>设置</a>
            <% } %>
            <% if (currentUser.role === 'admin' || currentUser.role === 'repair') { %>
              <a href="/admin/repairs" class="nav-link <%= currentPath.startsWith('/admin/repairs') ? 'is-active' : '' %>" <%= currentPath.startsWith('/admin/repairs') ? 'aria-current="page"' : '' %>>报修记录</a>
              <a href="/admin/maintenance-logs" class="nav-link <%= currentPath.startsWith('/admin/maintenance-logs') ? 'is-active' : '' %>" <%= currentPath.startsWith('/admin/maintenance-logs') ? 'aria-current="page"' : '' %>>维护记录</a>
            <% } %>
            <a href="/logout" class="nav-pill nav-pill-subtle">退出</a>
          <% } else { %>
            <a href="/login" class="nav-pill nav-pill-subtle">登录后台</a>
          <% } %>
        </nav>

        <div class="header-actions">
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换主题" title="切换明暗主题">
            <span class="theme-toggle-icon" data-theme-icon aria-hidden="true"></span>
          </button>
          <button
            class="nav-toggle"
            type="button"
            data-nav-toggle
            aria-expanded="false"
            aria-controls="site-nav"
          >
            <span class="nav-toggle-lines" aria-hidden="true"></span>
            <span class="sr-only">打开导航菜单</span>
          </button>
        </div>
      </div>
    </header>
    <main class="page">
