<%- include('partials/header', { title: `报修 #${repair.id}` }) %>
<section class="grid two-columns">
  <article class="panel stack">
    <h1>报修详情</h1>
    <dl class="details-grid">
      <div><dt>所属机台</dt><dd><%= repair.machine_name %></dd></div>
      <div><dt>机台编号</dt><dd><%= repair.machine_code %></dd></div>
      <div><dt>机台类型</dt><dd><%= repair.type_name %></dd></div>
      <div><dt>报修时间</dt><dd><%= formatDateTime(repair.created_at) %></dd></div>
      <div><dt>当前状态</dt><dd><span class="<%= ui.repairStatusClass(repair.status) %>"><%= ui.repairStatusLabels[repair.status] %></span></dd></div>
      <div class="full"><dt>问题内容</dt><dd><%= repair.content %></dd></div>
    </dl>
    <form method="post" action="/admin/repairs/<%= repair.id %>/status" class="inline-form">
    <label>当前状态
      <select name="status">
        <% statuses.repairStatuses.forEach((status) => { %>
          <option value="<%= status %>" <%= repair.status === status ? 'selected' : '' %>><%= ui.repairStatusLabels[status] %></option>
        <% }) %>
      </select>
    </label>
      <button class="button" type="submit">更新状态</button>
    </form>
    <form method="post" action="/admin/repairs/<%= repair.id %>/delete" data-confirm="确认删除该报修记录吗？关联的维护记录将一并从管理列表隐藏，删除后不可恢复。" data-confirm-confirm-text="确认删除" data-confirm-cancel-text="返回">
      <button class="button danger" type="submit">删除报修记录</button>
    </form>
  </article>

  <article class="panel stack">
    <h2>添加维修日志</h2>
    <form method="post" action="/admin/repairs/<%= repair.id %>/maintenance-logs" class="stack">
      <label>处理内容<textarea name="content" rows="6" required></textarea></label>
      <label>同步更新报修状态
        <select name="repair_status">
          <option value="">保持不变</option>
          <% statuses.repairStatuses.forEach((status) => { %>
            <option value="<%= status %>"><%= ui.repairStatusLabels[status] %></option>
          <% }) %>
        </select>
      </label>
      <button class="button" type="submit">新增维修日志</button>
    </form>
  </article>
</section>

<section class="panel stack top-gap">
  <h2>相关维修日志</h2>
  <% if (maintenanceLogs.length === 0) { %>
    <p>暂无维修日志。</p>
  <% } else { %>
    <div class="stack">
      <% maintenanceLogs.forEach((log) => { %>
        <article class="card stack compact">
          <div class="inline-row">
            <strong><%= log.operator_name %></strong>
            <span><%= formatDateTime(log.created_at) %></span>
          </div>
          <p><%= log.content %></p>
          <div class="inline-actions">
            <a href="/admin/maintenance-logs/<%= log.id %>">详情</a>
            <form method="post" action="/admin/maintenance-logs/<%= log.id %>/delete" data-confirm="确认删除该维护记录吗？删除后不可恢复。" data-confirm-confirm-text="确认删除" data-confirm-cancel-text="返回">
              <button class="link-button danger-text" type="submit">删除</button>
            </form>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
<%- include('partials/footer') %>
