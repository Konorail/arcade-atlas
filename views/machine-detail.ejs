<%- include('partials/header', { title: machine.name }) %>
<section class="grid two-columns">
  <article class="panel stack">
    <h1>机台基本信息</h1>
    <form method="post" action="/admin/machines/<%= machine.id %>" class="stack">
      <label>所属机台类型
        <select name="machine_type_id" required>
          <% machineTypes.forEach((type) => { %>
            <option value="<%= type.id %>" <%= machine.machine_type_id === type.id ? 'selected' : '' %>><%= type.name %></option>
          <% }) %>
        </select>
      </label>
      <label>机台名称<input name="name" required value="<%= machine.name %>" /></label>
      <label>机台编号<input name="machine_code" required value="<%= machine.machine_code %>" /></label>
      <label>状态
        <select name="status">
          <% statuses.machineStatuses.forEach((status) => { %>
            <option value="<%= status %>" <%= machine.status === status ? 'selected' : '' %>><%= ui.machineStatusLabels[status] %></option>
          <% }) %>
        </select>
      </label>
      <label>描述<textarea name="description" rows="4"><%= machine.description || '' %></textarea></label>
      <label>备注<textarea name="notes" rows="3"><%= machine.notes || '' %></textarea></label>
      <button class="button" type="submit">保存机台信息</button>
    </form>
    <form method="post" action="/admin/machines/<%= machine.id %>/delete" data-confirm="确认删除该机台吗？删除后不可恢复。" data-confirm-confirm-text="确认删除" data-confirm-cancel-text="返回">
      <button class="button danger" type="submit">删除机台</button>
    </form>
  </article>

  <article class="panel stack">
    <h2>二维码</h2>
    <img class="qr-image" src="<%= qrCodeDataUrl %>" alt="<%= machine.name %> 二维码" />
    <p>公开访问地址：<code>/machine/<%= machine.qr_token %></code></p>
    <div class="actions">
      <a class="button" href="/admin/machines/<%= machine.id %>/qr.png">下载二维码</a>
      <form method="post" action="/admin/machines/<%= machine.id %>/regenerate-qr" data-confirm="重新生成后旧二维码将失效，确定继续吗？">
        <button class="button secondary" type="submit">重新生成二维码</button>
      </form>
    </div>
  </article>
</section>

<section class="grid two-columns top-gap">
  <article class="panel stack">
    <h2>最近报修记录</h2>
    <% if (history.recentRepairs.length === 0) { %>
      <p>暂无报修记录。</p>
    <% } else { %>
      <div class="stack">
        <% history.recentRepairs.forEach((repair) => { %>
          <article class="card stack compact">
            <a href="/admin/repairs/<%= repair.id %>"><strong>#<%= repair.id %> · <span class="<%= ui.repairStatusClass(repair.status) %>"><%= ui.repairStatusLabels[repair.status] %></span></strong></a>
            <span><%= formatDateTime(repair.created_at) %></span>
            <p><%= repair.content %></p>
          </article>
        <% }) %>
      </div>
    <% } %>
  </article>

  <article class="panel stack">
    <h2>最近维修日志</h2>
    <% if (history.recentMaintenanceLogs.length === 0) { %>
      <p>暂无维修日志。</p>
    <% } else { %>
      <div class="stack">
        <% history.recentMaintenanceLogs.forEach((log) => { %>
          <article class="card stack compact">
            <strong><%= log.operator_name %></strong>
            <span><%= formatDateTime(log.created_at) %></span>
            <p><%= log.content %></p>
            <a href="/admin/maintenance-logs/<%= log.id %>">查看维护记录详情</a>
          </article>
        <% }) %>
      </div>
    <% } %>
  </article>
</section>
<%- include('partials/footer') %>
